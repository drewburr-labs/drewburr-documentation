{
  "uid": "apc-ups-overview",
  "title": "APC UPS Overview",
  "tags": [
    "ups",
    "apc",
    "power"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ups",
        "label": "UPS",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(upsCommStatus_ok, target)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(upsCommStatus_ok, target)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Status",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Output status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "upsBasicOutputStatus{target=~\"$ups\"} == 1",
          "legendFormat": "{{target}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "onLine": {
                  "color": "green",
                  "index": 0,
                  "text": "Online"
                },
                "onBattery": {
                  "color": "red",
                  "index": 1,
                  "text": "On battery"
                },
                "onSmartBoost": {
                  "color": "yellow",
                  "index": 2,
                  "text": "Boosting (low input)"
                },
                "onSmartTrim": {
                  "color": "yellow",
                  "index": 3,
                  "text": "Trimming (high input)"
                },
                "onBatteryTest": {
                  "color": "yellow",
                  "index": 4,
                  "text": "Self-test"
                },
                "selfTest": {
                  "color": "yellow",
                  "index": 5,
                  "text": "Self-test"
                },
                "off": {
                  "color": "red",
                  "index": 6,
                  "text": "Output off"
                },
                "softwareBypass": {
                  "color": "orange",
                  "index": 7,
                  "text": "Bypass"
                },
                "switchedBypass": {
                  "color": "orange",
                  "index": 8,
                  "text": "Bypass"
                },
                "hardwareFailureBypass": {
                  "color": "red",
                  "index": 9,
                  "text": "Bypass (hardware failure)"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "red",
                  "text": "No data",
                  "index": 10
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^upsBasicOutputStatus$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
