{
 "uid": "storage-move-replication",
 "title": "Storage Move: sas-pool → movebak",
 "tags": [
  "zfs",
  "storage",
  "move"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "templating": {
  "list": [
   {
    "type": "constant",
    "name": "target_bytes",
    "label": "Expected final size (bytes)",
    "query": "9850000000000",
    "hide": 2
   },
   {
    "type": "constant",
    "name": "instance",
    "query": "192.168.4.31:9100",
    "hide": 2
   },
   {
    "type": "constant",
    "name": "dev",
    "label": "movebak device",
    "query": "sdab",
    "hide": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "movebak health",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (state) (zpool_health{instance=\"$instance\",pool=\"movebak\"} == 1)",
     "legendFormat": "{{state}}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "textMode": "name",
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Copied to movebak",
   "gridPos": {
    "x": 3,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "zpool_allocated_bytes{instance=\"$instance\",pool=\"movebak\"}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "decimals": 2
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "gauge",
   "title": "Progress vs expected ~9.9T",
   "gridPos": {
    "x": 7,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * zpool_allocated_bytes{instance=\"$instance\",pool=\"movebak\"} / $target_bytes",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showThresholdMarkers": true
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       },
       {
        "color": "green",
        "value": 95
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Write rate (5m)",
   "gridPos": {
    "x": 11,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_disk_written_bytes_total{instance=\"$instance\",device=\"$dev\"}[5m])",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 10000000
       },
       {
        "color": "green",
        "value": 80000000
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Time remaining",
   "gridPos": {
    "x": 15,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "clamp_min($target_bytes - zpool_allocated_bytes{instance=\"$instance\",pool=\"movebak\"}, 0) / clamp_min(deriv(zpool_allocated_bytes{instance=\"$instance\",pool=\"movebak\"}[30m]), 1)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "dtdurations",
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "movebak allocated",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "zpool_allocated_bytes{instance=\"$instance\",pool=\"movebak\"}",
     "legendFormat": "copied"
    },
    {
     "refId": "B",
     "expr": "vector($target_bytes)",
     "legendFormat": "expected total"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "expected total"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "gray"
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Throughput: source reads vs movebak writes",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(node_disk_read_bytes_total{instance=\"$instance\",device=~\"sd[b-u]|sd(v|w|x|y|z|aa)\"}[2m]))",
     "legendFormat": "sas-pool + lake read"
    },
    {
     "refId": "B",
     "expr": "rate(node_disk_written_bytes_total{instance=\"$instance\",device=\"$dev\"}[2m])",
     "legendFormat": "movebak write"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Pool health (all)",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (pool, state) (zpool_health{instance=\"$instance\"} == 1)",
     "legendFormat": "{{pool}}: {{state}}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "name",
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "bargauge",
   "title": "Pool capacity",
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * zpool_capacity_ratio{instance=\"$instance\"}",
     "legendFormat": "{{pool}}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "stat",
   "title": "movebak free",
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "zpool_free_bytes{instance=\"$instance\",pool=\"movebak\"}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "decimals": 2
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "stat",
   "title": "Expected completion",
   "gridPos": {
    "x": 19,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1000 * (time() + clamp_min($target_bytes - zpool_allocated_bytes{instance=\"$instance\",pool=\"movebak\"}, 0) / clamp_min(deriv(zpool_allocated_bytes{instance=\"$instance\",pool=\"movebak\"}[30m]), 1))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "dateTimeAsLocal"
    },
    "overrides": []
   }
  }
 ]
}